#!/usr/bin/env python3
"""swallow -- answers for Citlalpol where a protocol has to be read.

    swallow serve      started by Citlalpol (citld) for a destination of access.json that goes
                       to a stand-in: the connection on stdin / stdout, the destination in
                       $CITLALPOL_ACCESS ({"destination": <its entry>, "base": <access.json's directory>})

It reads one HTTP/1.1 request, matches it against what the designer wrote in the
entry's "stages" (send: what is sent, expect: what should come back) and answers
with the reply written there. Where nothing is written yet it is the default: it
answers 501 with X-Swallow: undecided (never something that could pass for the
real service) and says the request was captured. What it did is one JSON line on
the fd $CITLALPOL_RESULT_FD, for Citlalpol's records; values of headers are never
in it (only their names), nor the body (only its size). It never guesses what a
request means. docs/ja/design-memo.md has the design.
"""
import fnmatch
import json
import os
import sys

HEAD_MAX = 65536
BODY_MAX = 1 << 20


def result(r):
    fd = os.environ.get("CITLALPOL_RESULT_FD")
    if fd and fd.isdigit():
        try:
            os.write(int(fd), (json.dumps(r, ensure_ascii=False) + "\n").encode())
        except OSError:
            pass


def answer(out, status, headers, body):
    if isinstance(body, (dict, list)):
        body = json.dumps(body, ensure_ascii=False)
        headers = dict({"Content-Type": "application/json"}, **headers)
    body = body.encode() if isinstance(body, str) else (body or b"")
    lines = ["HTTP/1.1 %s" % status] + ["%s: %s" % kv for kv in headers.items()] + \
        ["Content-Length: %d" % len(body), "Connection: close"]
    out.write(("\r\n".join(lines) + "\r\n\r\n").encode() + body)
    out.flush()


def reason(code):
    return {200: "OK", 201: "Created", 204: "No Content", 400: "Bad Request", 403: "Forbidden", 404: "Not Found",
            500: "Internal Server Error", 501: "Not Implemented"}.get(code, "")


def load_reply(spec, base):
    """a reply: inline {status, headers, body}, or the path of a JSON file of that shape (from access.json's directory)"""
    if isinstance(spec, str):
        with open(os.path.join(base, spec)) as f:
            spec = json.load(f)
    return int(spec.get("status", 200)), spec.get("headers", {}), spec.get("body", "")


def matches(m, method, path):
    return (m.get("method", "*") in ("*", method)) and fnmatch.fnmatchcase(path, m.get("path", "*"))


def serve():
    inp, out = sys.stdin.buffer, sys.stdout.buffer
    try:
        with open(os.environ["CITLALPOL_ACCESS"]) as f:
            a = json.load(f)
    except (KeyError, OSError, ValueError):
        a = {"destination": {}, "base": "."}
    dest, base = a.get("destination", {}), a.get("base", ".")
    stages = dest.get("stages", {})

    head = b""
    while b"\r\n\r\n" not in head:
        d = inp.read1(4096) if hasattr(inp, "read1") else inp.read(4096)
        if not d or len(head) > HEAD_MAX:
            result({"default": True, "captured": {"kind": "not-http", "bytes": len(head)},
                    "why": "swallow reads HTTP/1.1 only (yet): closed"})
            return
        head += d
    head, rest = head.split(b"\r\n\r\n", 1)
    lines = head.decode("latin-1").split("\r\n")
    parts = lines[0].split(" ")
    if len(parts) != 3 or not parts[2].startswith("HTTP/"):
        result({"default": True, "captured": {"kind": "not-http", "bytes": len(head)},
                "why": "not an HTTP/1.1 request line: closed"})
        return
    method, target = parts[0], parts[1]
    path = target.split("://", 1)[1].split("/", 1)[1] if "://" in target else target.lstrip("/")
    path = "/" + path
    names = [h.split(":", 1)[0].strip().lower() for h in lines[1:] if ":" in h]
    length = 0
    for h in lines[1:]:
        k, _, v = h.partition(":")
        if k.strip().lower() == "content-length" and v.strip().isdigit():
            length = min(int(v.strip()), BODY_MAX)
    while len(rest) < length:
        d = inp.read1(65536) if hasattr(inp, "read1") else inp.read(65536)
        if not d:
            break
        rest += d
    shown, _, query = path.partition("?")
    if query:   # the query's names only: a token can ride in a URL
        shown += "?" + "&".join(q.split("=", 1)[0] + "=…" for q in query.split("&") if q)
    req = {"method": method, "path": shown, "headers": names, "body_bytes": len(rest)}

    sent = next((s for s in stages.get("send", []) if matches(s.get("match", {}), method, path)), None)
    if sent is not None and sent.get("do", "stand_in") == "refuse":
        answer(out, "403 Forbidden", {"X-Swallow": "refused"}, "swallow: refused by access.json (%s)\n" % sent.get("id", "?"))
        result({"request": req, "matched": sent.get("id"), "default": False, "replied": "refused"})
        return
    if sent is not None and sent.get("do") == "pass":
        answer(out, "500 Internal Server Error", {"X-Swallow": "misplaced"},
               "swallow: pass is Citlalpol's decision, not a stand-in's; this request came to swallow (%s)\n" % sent.get("id", "?"))
        result({"request": req, "matched": sent.get("id"), "default": False, "why": "pass in stages.send: Citlalpol decides pass"})
        return
    exp = next((e for e in stages.get("expect", []) if sent is not None and e.get("on") == sent.get("id") and "reply" in e), None)
    if exp is None:
        # the designer has not said what to return: the default -- captured, and an answer
        # that cannot pass for the real service
        answer(out, "501 Not Implemented", {"X-Swallow": "undecided"},
               "swallow: what to return for %s %s is not decided yet (access.json stages)\n" % (method, path))
        result({"request": req, "matched": sent.get("id") if sent else None, "default": True, "captured": True})
        return
    try:
        code, headers, body = load_reply(exp["reply"], base)
    except (OSError, ValueError) as e:
        answer(out, "500 Internal Server Error", {"X-Swallow": "broken-reply"}, "swallow: the reply cannot be read: %s\n" % e)
        result({"request": req, "matched": sent.get("id"), "default": False, "why": "reply unreadable: %s" % e})
        return
    answer(out, "%d %s" % (code, reason(code)), headers, body)
    result({"request": req, "matched": sent.get("id"), "default": False,
            "replied": exp["reply"] if isinstance(exp["reply"], str) else "inline"})


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    if cmd == "serve":
        serve()
    elif cmd in ("help", "-h", "--help"):
        print(__doc__.split("\n\n")[1])
    else:
        sys.stderr.write("swallow: unknown command %s (only serve yet)\n" % cmd)
        sys.exit(1)


if __name__ == "__main__":
    main()
